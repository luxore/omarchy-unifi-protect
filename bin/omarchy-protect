#!/usr/bin/env python3
"""CLI boundary used by the Omarchy Protect QML surface."""

from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys

sys.dont_write_bytecode = True
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from omarchy_protect.client import (  # noqa: E402
    ProtectClient,
    ProtectError,
    SecretStore,
    canonical_console_url,
    launch_mpv,
    persist_values,
    persist_settings,
    serve_stream,
    validate_camera_id,
    watch_snapshots,
)


def print_json(value: object) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True), flush=True)


def boolean(value: str) -> bool:
    if value == "true":
        return True
    if value == "false":
        return False
    raise argparse.ArgumentTypeError("expected true or false")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omarchy-protect")
    parser.add_argument("--url", required=True, help="UniFi console root URL")
    parser.add_argument("--verify-tls", type=boolean, default=True)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("cameras")
    connect = commands.add_parser("connect")
    connect.add_argument("--stdin", action="store_true", dest="from_stdin", required=True)
    watch = commands.add_parser("watch")
    watch.add_argument("--camera", required=True)
    watch.add_argument("--interval", type=float, default=1.0)
    watch.add_argument("--once", action="store_true")
    view = commands.add_parser("view")
    view.add_argument("--camera", required=True)
    view.add_argument("--quality", choices=("auto", "high", "medium", "low"), default="auto")
    view.add_argument("--hardware-decoding", type=boolean, default=True)
    view.add_argument("--muted", type=boolean, default=False)
    stream = commands.add_parser("stream")
    stream.add_argument("--camera", required=True)
    stream.add_argument("--quality", choices=("auto", "high", "medium", "low"), default="auto")
    preference = commands.add_parser("preference")
    preference.add_argument("--key", required=True, choices=(
        "favoriteCameraId",
        "frameFit",
        "hardwareDecoding",
        "liveMuted",
        "liveQuality",
        "refreshMode",
        "showOfflineCameras",
        "viewerSize",
    ))
    preference.add_argument("--value", required=True)
    commands.add_parser("open")
    commands.add_parser("open-api-keys")
    commands.add_parser("forget")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        console_url = canonical_console_url(args.url)
        if args.command == "connect":
            api_key = sys.stdin.readline(4098)
            if len(api_key) > 4096:
                raise ProtectError("The UniFi API key is too long")
            client = ProtectClient(console_url, api_key, verify_tls=args.verify_tls)
            client.cameras()
            previous_key = SecretStore.lookup(console_url)
            SecretStore.store(console_url, api_key)
            try:
                persist_settings(console_url, args.verify_tls)
            except ProtectError:
                if previous_key:
                    SecretStore.store(console_url, previous_key)
                else:
                    SecretStore.clear(console_url)
                raise
            print_json(
                {
                    "ok": True,
                    "url": console_url,
                    "verifyTls": args.verify_tls,
                }
            )
            return 0
        if args.command == "open":
            subprocess.Popen(
                ["xdg-open", console_url + "/protect/"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            print_json({"ok": True})
            return 0
        if args.command == "open-api-keys":
            subprocess.Popen(
                ["xdg-open", "https://unifi.ui.com/"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            print_json({"ok": True})
            return 0
        if args.command == "forget":
            SecretStore.clear(console_url)
            persist_settings(console_url, args.verify_tls, setup_complete=False)
            print_json({"ok": True})
            return 0
        if args.command == "preference":
            choices = {
                "frameFit": {"fit", "fill"},
                "hardwareDecoding": {"true", "false"},
                "liveMuted": {"true", "false"},
                "liveQuality": {"auto", "high", "medium", "low"},
                "refreshMode": {"realtime", "fast", "balanced", "efficient"},
                "showOfflineCameras": {"true", "false"},
                "viewerSize": {"comfortable", "large"},
            }
            value = args.value
            if args.key == "favoriteCameraId":
                if value:
                    validate_camera_id(value)
            elif value not in choices[args.key]:
                raise ProtectError("Choose a valid viewer preference")
            persist_values({args.key: value})
            print_json({"ok": True, "key": args.key, "value": value})
            return 0

        api_key = SecretStore.lookup(console_url)
        if not api_key:
            raise ProtectError("Connect a UniFi API key in Setup", needs_auth=True)
        client = ProtectClient(console_url, api_key, verify_tls=args.verify_tls)
        if args.command == "cameras":
            print_json({"cameras": [camera.as_json() for camera in client.cameras()]})
        elif args.command == "watch":
            watch_snapshots(client, args.camera, args.interval, once=args.once)
        elif args.command == "stream":
            serve_stream(
                client.stream_url(args.camera, args.quality),
                lambda url: print_json({"url": url}),
                verify_tls=args.verify_tls,
            )
        elif args.command == "view":
            launch_mpv(
                client.stream_url(args.camera, args.quality),
                hardware_decoding=args.hardware_decoding,
                muted=args.muted,
                input_config=ROOT / "mpv-camera.conf",
            )
            print_json({"ok": True})
        return 0
    except BrokenPipeError:
        return 0
    except ProtectError as error:
        print_json({"error": str(error), "needsAuth": error.needs_auth})
        return 1
    except Exception as error:
        print_json({"error": "UniFi Protect Viewer failed unexpectedly", "needsAuth": False})
        print(f"omarchy-protect: unexpected {type(error).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
