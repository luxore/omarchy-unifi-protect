{
  "schemaVersion": 1,
  "id": "io.github.luxore.unifi-protect",
  "name": "UniFi Protect Viewer",
  "version": "0.1.1",
  "author": "Luxore",
  "license": "MIT",
  "description": "A read-only UniFi Protect camera viewer for the Omarchy bar.",
  "homepage": "https://github.com/luxore/omarchy-unifi-protect",
  "repository": "https://github.com/luxore/omarchy-unifi-protect",
  "keywords": [
    "unifi-protect",
    "camera",
    "security",
    "viewer",
    "rtsps"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "ProtectWidget.qml"
  },
  "barWidget": {
    "displayName": "UniFi Protect Viewer",
    "description": "View UniFi Protect cameras from the Omarchy bar",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "instanceUrl": "https://unifi.local",
      "setupComplete": false,
      "verifyTls": true,
      "favoriteCameraId": "",
      "frameFit": "fit",
      "hardwareDecoding": true,
      "liveMuted": false,
      "liveQuality": "auto",
      "refreshMode": "fast",
      "showOfflineCameras": true,
      "viewerSize": "large"
    },
    "schema": [
      {
        "key": "instanceUrl",
        "type": "string",
        "label": "UniFi console URL",
        "defaultValue": "https://unifi.local"
      },
      {
        "key": "verifyTls",
        "type": "boolean",
        "label": "Verify the console TLS certificate",
        "defaultValue": true
      },
      {
        "key": "frameFit",
        "type": "enum",
        "label": "Viewer framing",
        "options": ["fit", "fill"],
        "defaultValue": "fit"
      },
      {
        "key": "hardwareDecoding",
        "type": "boolean",
        "label": "Use GPU decoding in the pop-out",
        "defaultValue": true
      },
      {
        "key": "liveMuted",
        "type": "boolean",
        "label": "Start live video muted",
        "defaultValue": false
      },
      {
        "key": "liveQuality",
        "type": "enum",
        "label": "Preferred live quality",
        "options": ["auto", "high", "medium", "low"],
        "defaultValue": "auto"
      },
      {
        "key": "refreshMode",
        "type": "enum",
        "label": "Viewer mode",
        "options": ["realtime", "fast", "balanced", "efficient"],
        "defaultValue": "fast"
      },
      {
        "key": "showOfflineCameras",
        "type": "boolean",
        "label": "Show offline cameras",
        "defaultValue": true
      },
      {
        "key": "viewerSize",
        "type": "enum",
        "label": "Viewer size",
        "options": ["comfortable", "large"],
        "defaultValue": "large"
      }
    ]
  }
}
